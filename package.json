{
  "name": "signalk-noaa-tide-current",
  "version": "1.0.0",
  "description": "Signal K plugin for NOAA tide and current data",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "ci": "npm run lint && npm run build && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk",
    "tide",
    "current",
    "noaa"
  ],
  "author": "Maurice Tamman",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^1.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.0"
  },
  "signalk": {
    "name": "NOAA Tide & Current Data",
    "description": "Provides tide and current data from NOAA stations",
    "schema": "schema.json"
  }
}
